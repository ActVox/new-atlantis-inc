# Contact form delivery (Resend — https://resend.com)
#
# Copy this file to .env.local for local development, and set the same values
# as Environment Variables on the Vercel project for production.
#
# Setup checklist:
#   1. Create a Resend account and add `newatlantis.us` as a sending domain.
#   2. Add the DNS records Resend gives you and wait for the domain to verify.
#      Mail will NOT send until the domain shows as verified.
#   3. Create an API key with send permission and set RESEND_API_KEY below.
#   4. Set CONTACT_FROM_EMAIL to an address on the verified domain.
#
# Until RESEND_API_KEY is set, the contact form shows a "not configured" error
# rather than a false success.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender. Must be on a domain verified in Resend.
# Example: "New Atlantis Inc <noreply@newatlantis.us>"
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=info@newatlantis.us
